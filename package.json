{
  "name": "web-image-optimiser",
  "version": "0.1.0",
  "description": "Perceptual image optimiser for the web: strips metadata and writes the smallest PNG, JPEG, WebP, AVIF or SVG that stays above an SSIMULACRA 2 quality target.",
  "license": "MIT",
  "author": "Lewis Scoging",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miniscoggs/web-image-optimiser.git"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "web-image-optimiser": "./dist/bin/index.js",
    "wio": "./dist/bin/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema/*.json": "./dist/schema/*.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('wasm/pkg', 'dist/wasm', { recursive: true }); require('node:fs').copyFileSync('SKILL.md', 'dist/SKILL.md')\" && node scripts/build-schema.mjs",
    "build:wasm": "node wasm/build.mjs",
    "prepack": "npm run build",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "test": "vitest run && tsc -p tsconfig.test.json --noEmit",
    "test:fast": "vitest run --exclude \"tests/golden/**\" && tsc -p tsconfig.test.json --noEmit",
    "test:golden": "vitest run tests/golden/"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "sharp": "^0.35.4",
    "svgo": "^4.1.0",
    "tinyglobby": "^0.2.17",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.6",
    "@types/semver": "^7.8.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "semver": "^7.8.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
