{
  "name": "web-image-optimiser",
  "version": "0.1.0",
  "private": true,
  "description": "Perceptual image optimiser for the web: strips metadata and writes the smallest PNG, JPEG, WebP, AVIF or SVG that stays above an SSIMULACRA 2 quality target.",
  "license": "MIT",
  "author": "Lewis Scoging",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miniscoggs/web-image-optimiser.git"
  },
  "type": "module",
  "bin": {
    "web-image-optimiser": "./dist/bin/index.js",
    "wio": "./dist/bin/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('wasm/pkg', 'dist/wasm', { recursive: true })\" && vite build ui",
    "build:wasm": "node wasm/build.mjs",
    "dev": "node scripts/dev.mjs",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "test": "vitest run && npm run typecheck",
    "test:fast": "vitest run --exclude \"tests/golden/**\" --exclude \"tests/browser/**\" && npm run typecheck",
    "test:golden": "vitest run tests/golden/",
    "test:browser": "vitest run tests/browser/",
    "typecheck": "tsc -p tsconfig.test.json --noEmit && tsc -p ui/tsconfig.json"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "picomatch": "^4.0.7",
    "sharp": "^0.35.4",
    "svgo": "^4.1.0",
    "tinyglobby": "^0.2.17",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.6",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "semver": "^7.8.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
